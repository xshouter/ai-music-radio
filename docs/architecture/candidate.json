  "cards": [
    {
      "dot": "cyan",
      "title": "依赖方向",
      "items": [
        "renderer 只认 shared/ 的类型",
        "core 不认识 Electron，也不认识 SQLite 驱动",
        "具体实现只在 main/bootstrap.ts 被 new —— 唯一组装点"
      ]
    },
    {
      "dot": "emerald",
      "title": "出网三条腿",
      "items": [
        "LLM：Bearer 鉴权，换厂只改 prefs 里的 baseUrl + model",
        "音乐：内置兼容服务 → music.163.com",
        "嗓子：默认离线 piper；换 Fish Audio 同样只改 prefs"
      ]
    },
    {
      "dot": "amber",
      "title": "音频怎么到耳朵",
      "items": [
        "口播：界面从 /tts/<key>.wav 取字节，本地回放",
        "音乐：内核只把直链交给界面，音频不经本地中转",
        "首次体验那段口播是随包文件，换嗓子也不跟着变"
      ]
    },
    {
      "dot": "violet",
      "title": "两个子进程在 asar 外",
      "items": [
        "piper 与内置网易云服务都要被 spawn，塞进 asar 就跑不起来",
        "piper 的运行时目录必须纯 ASCII，否则静默产出 0 字节",
        "口播缓存上限 400 个文件，按 mtime 回收"
      ]
    }
  ]
